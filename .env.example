# Copy to .env.local to change these for your machine (.env.local is gitignored).

# Where the dev server's /api proxy sends requests (npm run dev).
VITE_API_PROXY_TARGET=http://localhost:8080

# Base URL the app calls the API at. Empty (the default) means the same origin, i.e. /api through the dev proxy.
# Set it only when the frontend is served somewhere that doesn't proxy /api; the backend then needs CORS for this origin.
VITE_API_URL=

# Local development only: the user sent in the X-User header (the backend's dev profile). Leave empty to be anonymous.
VITE_DEV_USER=dev
