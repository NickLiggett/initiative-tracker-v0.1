# Copy to .env.local to change these for your machine (.env.local is gitignored).

# Where the dev server's /api proxy sends requests (npm run dev).
VITE_API_PROXY_TARGET=http://localhost:8080

# Base URL the app calls the API at. Empty (the default) means the same origin, i.e. /api through the dev proxy.
# Set it only when the frontend is served somewhere that doesn't proxy /api; the backend then needs CORS for this origin.
VITE_API_URL=

# Local development only: the user sent in the X-User header (the backend's dev profile). Leave empty to be anonymous.
# Ignored when real sign-in is on (below).
VITE_DEV_USER=dev

# Real sign-in, through the backend's OpenID Connect provider (Keycloak). Set both to turn it on: the app then shows a
# login page and sends the user's token instead of the X-User header. The backend must run with token sign-in
# (docker compose -f compose.yaml -f compose.auth.yaml up -d --build, in open5e-backend).
# VITE_OIDC_ISSUER=http://localhost:8180/realms/open5e
# VITE_OIDC_CLIENT_ID=initiative-tracker
# Where the provider sends people back to after signing in; the app's own address by default.
# VITE_OIDC_REDIRECT_URI=
